---
const snippets = [
  { id: 'python', label: 'Python', file: 'hello.py', comment: '#', code: 'name = input("Your name? ")\nprint("Hello,", name)', run: 'python hello.py' },
  { id: 'bash', label: 'Bash', file: 'hello.sh', comment: '#', code: 'read -p "Your name? " name\necho "Hello, $name"', run: 'bash hello.sh' },
  { id: 'powershell', label: 'PowerShell', file: 'hello.ps1', comment: '#', code: '$name = Read-Host "Your name?"\nWrite-Host "Hello, $name"', run: 'pwsh hello.ps1' },
  { id: 'javascript', label: 'JavaScript', file: 'hello.js', comment: '//', code: 'const name = prompt("Your name?");\nconsole.log("Hello,", name);', run: 'open the browser console' },
];
---

<div class="card terminal" data-hello-tabs>
  <div class="bar">
    <span class="dot" aria-hidden="true"></span>
    <span class="dot" aria-hidden="true"></span>
    <span class="dot" aria-hidden="true"></span>
    <span class="bar-title">hello: same idea, four languages</span>
  </div>
  <div role="tablist" aria-label="Language" class="tabs">
    {
      snippets.map((s, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${s.id}`}
          aria-controls={`panel-${s.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {s.label}
        </button>
      ))
    }
  </div>
  {
    snippets.map((s, i) => (
      <div role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
        <code class="code">
          <span class="c">{s.comment} {s.file}</span>
          <br />
          {s.code}
        </code>
        <div class="out">
          <span class="prompt">$</span> {s.run}
          <br />
          <span class="muted">Your name? </span>Sam
          <br />
          <span class="result">Hello, Sam</span>
        </div>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-hello-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`);
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        next.focus();
        select(next);
      });
    });
  });
</script>

<style>
  .terminal {
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #3a4458;
  }
  .bar-title {
    margin-left: 8px;
    font: 13px var(--font-mono);
    color: var(--muted);
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 12px 12px 0;
  }
  [role='tab'] {
    font: 14px var(--font-mono);
    padding: 10px 14px;
    min-height: 44px;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
  }
  [role='tab'][aria-selected='true'] {
    border-color: var(--accent);
    background: var(--surface-2);
    color: var(--text);
  }
  .code {
    display: block;
    margin: 0;
    padding: 24px 20px 8px;
    font: 16px/1.7 var(--font-mono);
    white-space: pre-line;
    color: var(--text);
  }
  .c {
    color: #7c8799;
  }
  .out {
    margin: 12px 20px 20px;
    padding: 14px 16px;
    background: var(--bg);
    border-radius: 8px;
    font: 14px/1.7 var(--font-mono);
    color: var(--muted);
  }
  .prompt {
    color: var(--accent);
  }
  .result {
    color: var(--text);
  }
</style>

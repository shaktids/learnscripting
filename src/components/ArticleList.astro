---
import Base from '../layouts/Base.astro';
import ArticleCard from './ArticleCard.astro';
import { LANGUAGES } from '../data/site';
import type { Page } from 'astro';
import type { Article, Topic } from '../data/articles';

interface Props {
  page: Page<Article>;
  topics: Topic[];
}

const { page, topics } = Astro.props;
const pageHref = (n: number) => (n === 1 ? '/articles/' : `/articles/page/${n}/`);
const nums = Array.from({ length: page.lastPage }, (_, i) => i + 1).filter(
  (n) => n === 1 || n === page.lastPage || Math.abs(n - page.currentPage) <= 2,
);
---

<Base
  title={page.currentPage === 1 ? 'All articles' : `All articles, page ${page.currentPage}`}
  description="Every scripting article on LearnScripting, newest first."
>
  <section class="container section">
    <h1 class="section-title">All articles</h1>
    <p class="section-lead">{page.total} articles. Search, or browse by language or topic.</p>

    <div class="controls">
      <label for="q" class="sr-only">Search articles</label>
      <input id="q" type="search" placeholder="Search, e.g. loops, selenium, chmod…" autocomplete="off" />
      <nav class="chips" aria-label="Browse">
        {LANGUAGES.map((l) => <a href={`/${l.id}/`}>{l.name}</a>)}
        {topics.slice(0, 8).filter((t) => !LANGUAGES.some((l) => l.name === t.name)).map((t) => (
          <a href={`/topics/${t.slug}/`}>{t.name}</a>
        ))}
        <a href="/topics/">All topics →</a>
      </nav>
    </div>

    <div id="results" hidden>
      <p id="results-count" class="section-lead" role="status" aria-live="polite"></p>
      <ul id="results-list" class="results"></ul>
    </div>

    <div id="browse">
      <div class="grid grid-3">
        {page.data.map((a) => <ArticleCard article={a} />)}
      </div>

      {
        page.lastPage > 1 && (
          <nav class="pager" aria-label="Pages">
            {page.url.prev ? <a href={page.url.prev}>← Newer</a> : <span />}
            <span class="nums">
              {nums.map((n, i) => (
                <>
                  {i > 0 && n - nums[i - 1] > 1 && <span class="gap">…</span>}
                  <a href={pageHref(n)} aria-current={n === page.currentPage ? 'page' : undefined}>
                    {n}
                  </a>
                </>
              ))}
            </span>
            {page.url.next ? <a href={page.url.next}>Older →</a> : <span />}
          </nav>
        )
      }
    </div>
  </section>
</Base>

<script>
  type Entry = { t: string; d: string; u: string; l: string; c: string };
  const input = document.querySelector<HTMLInputElement>('#q')!;
  const results = document.querySelector<HTMLElement>('#results')!;
  const list = document.querySelector<HTMLUListElement>('#results-list')!;
  const count = document.querySelector<HTMLElement>('#results-count')!;
  const browse = document.querySelector<HTMLElement>('#browse')!;
  let index: Entry[] | null = null;

  async function search() {
    const q = input.value.trim().toLowerCase();
    const url = new URL(location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);

    if (q.length < 2) {
      results.hidden = true;
      browse.hidden = false;
      return;
    }
    index ??= await fetch('/search.json').then((r) => r.json());
    const words = q.split(/\s+/);
    const hits = index!.filter((e) => {
      const hay = `${e.t} ${e.d} ${e.l} ${e.c}`.toLowerCase();
      return words.every((w) => hay.includes(w));
    });
    list.replaceChildren(
      ...hits.slice(0, 100).map((e) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = e.u;
        a.textContent = e.t;
        const meta = document.createElement('span');
        meta.textContent = e.l;
        const p = document.createElement('p');
        p.textContent = e.d;
        li.append(meta, a, p);
        return li;
      }),
    );
    count.textContent = hits.length
      ? `${hits.length} result${hits.length === 1 ? '' : 's'}${hits.length > 100 ? ' (showing the first 100)' : ''}`
      : 'No articles match. Try a different word.';
    results.hidden = false;
    browse.hidden = true;
  }

  let timer: number | undefined;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(search, 150);
  });
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) {
    input.value = initial;
    search();
  }
</script>

<style>
  .controls {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }
  input {
    width: 100%;
    max-width: 520px;
    min-height: 48px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    color: var(--text);
    padding: 12px 16px;
    font: 16px var(--font-sans);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted-2);
    font-size: 14px;
    text-decoration: none;
  }
  .chips a:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .results :global(li) {
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .results :global(span) {
    font: 13px var(--font-mono);
    color: var(--muted);
  }
  .results :global(a) {
    font: 700 19px/1.3 var(--font-display);
    color: var(--text);
    text-decoration: none;
  }
  .results :global(a:hover) {
    color: var(--accent);
  }
  .results :global(p) {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .pager {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .pager a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    text-decoration: none;
  }
  .pager a:hover {
    border-color: var(--border-strong);
  }
  .pager a[aria-current='page'] {
    border-color: var(--accent);
    color: var(--accent);
  }
  .nums {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .gap {
    color: var(--muted);
    padding: 0 4px;
  }
</style>

---
import { LANG_TINT } from '../data/site';
import { articleLabel, articleUrl, formatDate, readingMinutes, type Article } from '../data/articles';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, description, lang, level, pubDate, legacy } = article.data;
const label = articleLabel(article);
---

<article class="card article-card">
  <div class="tags">
    <span class="tag" style={`color: ${LANG_TINT[lang]}`}>{label}</span>
    {!legacy && <span class="tag">{level === 'beginner' ? 'Beginner' : 'Intermediate'}</span>}
  </div>
  <h3><a href={articleUrl(article)}>{title}</a></h3>
  <p>{description}</p>
  <span class="meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {readingMinutes(article.body)} min read
  </span>
</article>

<style>
  .article-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
  }
  .article-card:hover {
    border-color: var(--border-strong);
  }
  h3 {
    margin: 0;
    font-size: 22px;
    line-height: 1.3;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  /* Make the whole card clickable via the title link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .meta {
    margin-top: auto;
    font-size: 13px;
    color: #8e97a8;
  }
</style>

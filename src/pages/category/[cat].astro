---
/**
 * Old WordPress category URLs (/category/<name>/) -> /topics/<slug>/.
 * GitHub Pages can't send real 301 redirects, so this is a tiny HTML page
 * with a canonical link and an instant meta refresh, which search engines follow.
 */
import categories from '../../data/wp-categories.json';
import { getTopics } from '../../data/articles';

export async function getStaticPaths() {
  const topics = new Set((await getTopics()).map((t) => t.slug));
  return Object.entries(categories as Record<string, string>).map(([cat, slug]) => ({
    params: { cat },
    props: { target: topics.has(slug) ? `/topics/${slug}/` : '/topics/' },
  }));
}

const { target } = Astro.props as { target: string };
const url = new URL(target, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved</title>
    <link rel="canonical" href={url} />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>This page has moved to <a href={target}>{url.href}</a>.</p>
  </body>
</html>
